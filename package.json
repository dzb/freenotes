{
  "name": "macnotes",
  "version": "1.0.7",
  "private": true,
  "description": "一款本地优先的 macOS 风格笔记应用，支持 SQLite 存储、全文搜索、附件备份与单条导出。",
  "desktopName": "macnotes.desktop",
  "author": {
    "name": "dzb",
    "email": "dzb2k9@outlook.com",
    "url": "https://github.com/dzb"
  },
  "homepage": "https://github.com/dzb/freenotes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dzb/freenotes.git"
  },
  "bugs": {
    "url": "https://github.com/dzb/freenotes/issues"
  },
  "keywords": [
    "notes",
    "note-taking",
    "local-first",
    "macos",
    "windows",
    "linux",
    "electron",
    "react",
    "tiptap",
    "rich-text"
  ],
  "license": "MIT",
  "main": "dist-electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:renderer": "vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "build": "npm run typecheck && npm run build:renderer && npm run build:electron",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "start": "electron .",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb rpm",
    "dist:mac": "npm run build && electron-builder --mac dmg zip",
    "dist:win": "npm run build && electron-builder --win nsis"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tiptap/extension-highlight": "^3.35.0",
    "@tiptap/extension-image": "^3.35.0",
    "@tiptap/extension-link": "^3.35.0",
    "@tiptap/extension-placeholder": "^3.35.0",
    "@tiptap/extension-table": "^3.35.0",
    "@tiptap/extension-task-item": "^3.35.0",
    "@tiptap/extension-task-list": "^3.35.0",
    "@tiptap/extension-text-align": "^3.35.0",
    "@tiptap/extension-underline": "^3.35.0",
    "@tiptap/pm": "^3.35.0",
    "@tiptap/react": "^3.35.0",
    "@tiptap/starter-kit": "^3.35.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.77.0",
    "playwright-core": "^1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "build": {
    "appId": "app.macnotes.local",
    "productName": "FreeNotes",
    "asar": true,
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "dist-electron/**/*",
      "dist-renderer/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "name": "macnotes"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Utility;Office",
      "icon": "build/icons",
      "synopsis": "macOS 风格的本地笔记应用",
      "description": "一款本地优先的笔记应用，支持文件夹、富文本、置顶、最近删除、全文搜索、完整备份和单条导出。所有数据仅保存在本机。",
      "maintainer": "dzb <dzb2k9@outlook.com>",
      "syncDesktopName": true
    },
    "artifactName": "FreeNotes-${version}-${arch}.${ext}",
    "extraResources": [
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      }
    ],
    "deb": {
      "packageCategory": "utils",
      "depends": [
        "libgtk-3-0t64 | libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0t64 | libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libgbm1",
        "libdrm2",
        "libasound2t64 | libasound2"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": "-"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
